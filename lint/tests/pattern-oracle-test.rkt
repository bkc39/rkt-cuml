#lang racket/base

(require (only-in racket/match match-define)
         (only-in racket/set list->seteq)
         (only-in rackunit check-equal? check-false check-not-false check-true test-case)
         (only-in "../private/patterns.rkt" direct-pattern-names pattern-names)
         (only-in "private/oracle.rkt" alpha-copy? racket-binders racket-value rename))

(define (procedure pattern names)
  `(define (f subject)
     (match subject
       [,pattern (list ,@names)])))

(define (renamed names)
  (for/list ([name (in-list names)])
    (cons name (string->symbol (format "~a-renamed" name)))))

(test-case "the oracle tells a binder from a reference"
  (check-equal? (racket-binders '(app car (? number? n))) '(n))
  (check-equal? (racket-binders '(point a _)) '(a)))

